---
// Colophon: how the page was made, what the data is, and where to go next.
import { cfg, withBase } from "../../lib/source";
const date = new Date(`${cfg.captureDate}T12:00:00Z`).toLocaleDateString("en-GB", { day: "numeric", month: "long", year: "numeric", timeZone: "UTC" });
---

<footer class="colophon">
  <div class="colophon__inner">
    <p class="colophon__title">Colophon</p>
    <p>
      Set in Latin Modern Roman, a digital Computer Modern, the face of GitResume's live sheet and three of its four LaTeX templates, and JetBrains Mono for paths and commits.
      Proof generated by GitResume's no-key fallback from {cfg.owner}'s public repos on {date}.
      Built with Astro from the <a href={`${cfg.repoUrl}/tree/${cfg.branch}/site`}>site/</a> folder of the repository. GitResume is released under the <a href={`${cfg.repoUrl}/blob/${cfg.branch}/LICENSE`}>MIT License</a>.
    </p>
    <p class="colophon__links">
      <a href={cfg.appUrl} rel="noopener">Open GitResume</a>
      <a href={withBase("guide/")}>Read the guide</a>
      <a href={cfg.repoUrl} rel="noopener">Source on GitHub</a>
    </p>
    <p class="colophon__end" aria-hidden="true">&para;</p>
  </div>
</footer>
