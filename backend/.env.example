# GitResume Backend Environment Variables
# Copy this file to .env and fill in your values

# Groq API Key (optional — enables ultra-fast Llama-3 AI resume generation)
GROQ_API_KEY=

# OpenAI API Key (optional — fallback if Groq is not set)
OPENAI_API_KEY=

# OpenRouter API Key (optional — enables high-performance models like Llama 3.3 70B, Gemini 2.5, or Claude)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct
